---
import SectionContainer from '../components/ui/SectionContainer.astro'
import Layout from '../layouts/Layout.astro'
import WorkExperience from '../components/sections/WorkExperience.astro'
import Works from '../components/sections/Work.astro'
import Brifcase from '../icons/Brifcase.astro'
import Code from '../icons/Code.astro'
import Profile from '../icons/Profile.astro'
import Footer from '../components/sections/Footer.astro'
import AboutMe from '../components/sections/AboutMe.astro'
import Hero from '../components/sections/Hero.astro'
import Projects from '../components/sections/Projects.astro'
import Title from '../components/ui/Title .astro'
---

<Layout
  title="Portafolio Lizandro Antonio Santos - Desarrollador Web"
  description="Contratame para crear tu web o potenciar tu negocio">
  <main class="px-6 md:px-10 lg:px-16 max-w-7xl mx-auto">
    <!-- Hero Section -->
    <SectionContainer class="pt-10 md:mt-20 mt-10 md:py-20">
      <Hero />
    </SectionContainer>

    <!-- Experiencia Section -->
    <SectionContainer id="experiencia" class="mt-40 mb-24">
      <Title color="text-violet">
        <Brifcase class="size-6 md:size-7" />
        Experiencia profesional
      </Title>
        <WorkExperience />
    </SectionContainer>

    <!-- Proyectos Section -->
    <SectionContainer id="proyectos" class="mt-40 mb-24">
      <Title color="text-green">
        <Brifcase class="size-6 md:size-7" />
        Últimos trabajos
      </Title>
      <div class="flex flex-row mt-16 gap-8 flex-wrap justify-center md:justify-start">
        <Works />
      </div>
      
      <!-- <Title color="text-violet">
        <Code class="size-6 md:size-7" />
        Proyectos personales
      </Title>
      <div class="flex flex-row mt-16 gap-8 flex-wrap justify-center md:justify-start">
        <Projects />
      </div> -->
    </SectionContainer>

    <!-- Sobre Mi Section -->
    <SectionContainer id="sobre-mi" class="mt-40 mb-24">
      <Title color="text-blue">
        <Profile class="size-6 md:size-7" />
        Sobre mi
      </Title>
      <AboutMe />
    </SectionContainer>

    <!-- Footer -->
    <Footer />
  </main>
</Layout>
