      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&display=swap');\n\n  .portfolio-canvas {\n    --blue: #2ccbf3;\n    --violet: #bb99fa;\n    --green: #b6d161;\n    --dark-bg: #0a0a0f;\n    --dark-surface: #111118;\n    --dark-card: #1a1a24;\n    --dark-border: #2a2a3a;\n    min-height: 100vh;\n    color: #f8fafc;\n    background: var(--dark-bg);\n    font-family: 'Geist', 'Geist Sans', Inter, system-ui, sans-serif;\n  }\n\n  @keyframes previewFadeIn {\n    from { opacity: 0; }\n    to { opacity: 1; }\n  }\n\n  @keyframes previewFadeInUp {\n    from { opacity: 0; transform: translateY(20px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n\n  @keyframes previewSlideIn {\n    from { opacity: 0; transform: translateX(-20px); }\n    to { opacity: 1; transform: translateX(0); }\n  }\n\n  .preview-fade-in { animation: previewFadeIn .8s ease-out both; }\n  .preview-fade-in-up { animation: previewFadeInUp .6s ease-out both; }\n  .preview-slide-in { animation: previewSlideIn .5s ease-out both; }\n\n  .portfolio-canvas .glass-card {\n    background: color-mix(in srgb, var(--dark-surface) 62%, transparent);\n    border: 1px solid color-mix(in srgb, var(--dark-border) 72%, transparent);\n    backdrop-filter: blur(14px);\n  }\n\n  .portfolio-canvas .glass-card:hover {\n    background: color-mix(in srgb, var(--dark-surface) 82%, transparent);\n    border-color: var(--dark-border);\n    box-shadow: 0 24px 48px rgba(0,0,0,.28);\n  }\n\n  .portfolio-canvas .section-rule {\n    background: linear-gradient(90deg, var(--dark-border), color-mix(in srgb, var(--dark-border) 45%, transparent), transparent);\n  }\n\n  .portfolio-canvas .timeline-line {\n    background: linear-gradient(180deg, color-mix(in srgb, var(--blue) 42%, var(--dark-border)), color-mix(in srgb, var(--violet) 24%, var(--dark-border)), transparent);\n  }\n\n  .portfolio-canvas .project-image {\n    transition: transform .7s ease-out, filter .7s ease-out;\n  }\n\n  .portfolio-canvas .project-card:hover .project-image {\n    transform: scale(1.06);\n    filter: brightness(1.08);\n  }\n\n  .portfolio-canvas .soft-grid {\n    background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px);\n    background-size: 50px 50px;\n  }\n\n  .portfolio-canvas .muted-copy { color: #cbd5e1; }\n\n  @media (max-width: 767px) {\n    .portfolio-canvas .hero-copy h1 { font-size: 3rem; }\n    .portfolio-canvas .hero-copy p { max-width: 100%; }\n  }\n</style>\n<div class=\"portfolio-canvas relative isolate overflow-hidden bg-[var(--dark-bg)]\" data-kid=\"1\" data-name=\"portfolio main canvas container\">\n    <div class=\"pointer-events-none fixed inset-0 -z-20 bg-gradient-to-br from-[#0a0a0f] via-[#0f0f1a] to-[#050508]\" data-kid=\"1-1\" data-name=\"fixed background gradient\">\n    </div>\n    <div class=\"pointer-events-none fixed inset-0 -z-10 opacity-30\" data-kid=\"1-2\" data-name=\"hero section animated background light orbs\">\n        <div class=\"absolute left-[20%] top-0 h-96 w-96 rounded-full bg-[var(--blue)]/10 blur-3xl\" data-kid=\"1-2-1\" data-name=\"hero background blue orb\">\n        </div>\n        <div class=\"absolute bottom-0 right-[20%] h-96 w-96 rounded-full bg-[var(--violet)]/10 blur-3xl\" data-kid=\"1-2-2\" data-name=\"hero background violet orb\">\n        </div>\n    </div>\n    <div class=\"soft-grid pointer-events-none fixed inset-0 -z-10 opacity-[0.03]\" data-kid=\"1-3\" data-name=\"fixed soft grid pattern overlay\">\n    </div>\n    <header class=\"preview-fade-in fixed left-0 right-0 top-4 z-50 flex justify-center px-4 md:top-6\" data-kid=\"1-4\" data-name=\"header navigation container\" style=\"animation-delay:.05s\">\n        <nav class=\"flex w-full max-w-4xl items-center justify-between rounded-full border border-[var(--dark-border)]/60 bg-[var(--dark-surface)]/80 px-4 py-2.5 shadow-lg shadow-black/20 backdrop-blur-xl md:justify-center\" data-kid=\"1-4-1\" data-name=\"sticky navigation bar\">\n            <div class=\"text-sm font-bold text-white md:hidden\" data-kid=\"1-4-1-1\" data-name=\"mobile initials logo\">\n                AC\n            </div>\n            <div class=\"hidden items-center justify-center gap-x-1 font-medium md:flex lg:gap-x-2\" data-kid=\"1-4-1-2\" data-name=\"desktop navigation links container\">\n                <a class=\"rounded-full px-4 py-2 text-sm text-gray-300 transition hover:bg-white/5 hover:text-white\" data-kid=\"1-4-1-2-1\" data-name=\"navigation link inicio\" href=\"#inicio\">\n                    Inicio\n                </a>\n                <a class=\"rounded-full px-4 py-2 text-sm text-gray-300 transition hover:bg-white/5 hover:text-white\" data-kid=\"1-4-1-2-2\" data-name=\"navigation link experiencia\" href=\"#trayectoria\">\n                    Experiencia\n                </a>\n                <a class=\"rounded-full px-4 py-2 text-sm text-gray-300 transition hover:bg-white/5 hover:text-white\" data-kid=\"1-4-1-2-3\" data-name=\"navigation link certificaciones\" href=\"#certificaciones\">\n                    Certificaciones\n                </a>\n                <a class=\"rounded-full px-4 py-2 text-sm text-gray-300 transition hover:bg-white/5 hover:text-white\" data-kid=\"1-4-1-2-4\" data-name=\"navigation link proyectos\" href=\"#proyectos\">\n                    Proyectos\n                </a>\n                <a class=\"rounded-full px-4 py-2 text-sm text-gray-300 transition hover:bg-white/5 hover:text-white\" data-kid=\"1-4-1-2-5\" data-name=\"navigation link sobre mi\" href=\"#sobre-mi\">\n                    Sobre mi\n                </a>\n            </div>\n            <button aria-label=\"Menú\" class=\"flex h-10 w-10 flex-col items-center justify-center gap-1.5 rounded-lg text-gray-300 md:hidden\" data-kid=\"1-4-1-3\" data-name=\"mobile menu hamburger button\">\n                <span class=\"h-0.5 w-6 rounded bg-gray-300\" data-kid=\"1-4-1-3-1\" data-name=\"hamburger bar top\">\n                </span>\n                <span class=\"h-0.5 w-6 rounded bg-gray-300\" data-kid=\"1-4-1-3-2\" data-name=\"hamburger bar middle\">\n                </span>\n                <span class=\"h-0.5 w-6 rounded bg-gray-300\" data-kid=\"1-4-1-3-3\" data-name=\"hamburger bar bottom\">\n                </span>\n            </button>\n        </nav>\n    </header>\n    <main class=\"mx-auto w-full max-w-7xl px-6 pb-10 md:px-10 lg:px-16\" data-kid=\"1-5\" data-name=\"main content wrapper\" id=\"inicio\">\n        <section aria-label=\"Presentación\" class=\"pt-28 md:pt-36 lg:pt-40\" data-kid=\"1-5-1\" data-name=\"hero section\">\n            <div class=\"flex flex-col items-center gap-12 md:flex-row md:items-center md:gap-16\" data-kid=\"1-5-1-1\" data-name=\"hero profile flex container\">\n                <div class=\"hero-copy flex-1 space-y-8 preview-fade-in-up\" data-kid=\"1-5-1-1-1\" data-name=\"hero text content section\" style=\"animation-delay:.12s\">\n                    <div class=\"preview-fade-in flex items-center gap-4\" data-kid=\"1-5-1-1-1-1\" data-name=\"hero status badge wrapper\" style=\"animation-delay:.2s\">\n                        <span class=\"relative inline-flex overflow-hidden rounded-full p-[1.5px]\" data-kid=\"1-5-1-1-1-1-1\" data-name=\"spinning status ring\">\n                            <span class=\"absolute inset-[-1000%] animate-[spin_3s_linear_infinite] bg-[conic-gradient(from_90deg_at_50%_50%,rgba(182,209,97,0.8)_0%,rgba(44,203,243,0.4)_50%,rgba(182,209,97,0.8)_100%)]\" data-kid=\"1-5-1-1-1-1-1-1\">\n                            </span>\n                            <span class=\"relative inline-flex items-center gap-2 rounded-full border border-[var(--green)]/20 bg-[var(--dark-surface)]/90 px-4 py-1.5 text-sm font-medium text-[var(--green)] backdrop-blur-sm\" data-kid=\"1-5-1-1-1-1-1-2\">\n                                <span class=\"h-2 w-2 animate-pulse rounded-full bg-[var(--green)]\" data-kid=\"1-5-1-1-1-1-1-2-1\">\n                                </span>\n                                Disponible para trabajar\n                            </span>\n                        </span>\n                    </div>\n                    <div class=\"space-y-4\" data-kid=\"1-5-1-1-1-2\" data-name=\"hero identity name container\">\n                        <p class=\"font-mono text-base text-[var(--blue)] opacity-90 md:text-xl\" data-kid=\"1-5-1-1-1-2-1\" data-name=\"hero greeting\">\n                            Hola, mi nombre es\n                        </p>\n                        <h1 class=\"text-5xl font-extrabold leading-[1.1] md:text-6xl lg:text-7xl\" data-kid=\"1-5-1-1-1-2-2\" data-name=\"hero main name headline\">\n                            <span class=\"text-white\" data-kid=\"1-5-1-1-1-2-2-1\" data-name=\"first name span\">\n                                Lizandro Antonio\n                            </span>\n                            <span class=\"bg-gradient-to-r from-[var(--blue)] to-[var(--green)] bg-clip-text text-transparent\" data-kid=\"1-5-1-1-1-2-2-2\" data-name=\"last name span\">\n                                Santos\n                            </span>\n                        </h1>\n                    </div>\n                    <div class=\"space-y-3\" data-kid=\"1-5-1-1-1-3\" data-name=\"hero job description container\">\n                        <h2 class=\"text-2xl font-bold text-gray-300 md:text-4xl\" data-kid=\"1-5-1-1-1-3-1\" data-name=\"role subtitle\">\n                            Desarrollador Frontend\n                        </h2>\n                        <p class=\"max-w-2xl text-lg leading-[1.8] text-gray-300 md:text-xl\" data-kid=\"1-5-1-1-1-3-2\" data-name=\"role details paragraph\">\n                            Especializado en\n                            <strong class=\"font-semibold text-[var(--blue)]\" data-kid=\"1-5-1-1-1-3-2-1\" data-name=\"tech react\">\n                                React\n                            </strong>\n                            con enfoque en\n                            <strong class=\"font-semibold text-[var(--violet)]\" data-kid=\"1-5-1-1-1-3-2-2\" data-name=\"tech clean architecture\">\n                                Clean Architecture\n                            </strong>\n                            y buenas prácticas. Cuento con experiencia en Backend con\n                            <strong class=\"font-semibold text-[var(--green)]\" data-kid=\"1-5-1-1-1-3-2-3\" data-name=\"tech nestjs express\">\n                                NestJS/Express\n                            </strong>\n                            para APIs escalables.\n                        </p>\n                    </div>\n                    <div class=\"flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-gray-300 md:text-base\" data-kid=\"1-5-1-1-1-4\" data-name=\"hero contact details list\">\n                        <span class=\"flex items-center gap-2\" data-kid=\"1-5-1-1-1-4-1\" data-name=\"location label\">\n                            <iconify-icon data-kid=\"1-5-1-1-1-4-1-1\" data-name=\"location icon\" icon=\"mdi:map-marker-outline\" style=\"color:var(--blue);width:18px;height:18px\">\n                            </iconify-icon>\n                            Toluca, México\n                        </span>\n                        <span class=\"flex items-center gap-2\" data-kid=\"1-5-1-1-1-4-2\" data-name=\"education label\">\n                            <iconify-icon data-kid=\"1-5-1-1-1-4-2-1\" data-name=\"education icon\" icon=\"mdi:school-outline\" style=\"color:var(--green);width:18px;height:18px\">\n                            </iconify-icon>\n                            Ing. Sistemas Computacionales\n                        </span>\n                        <span class=\"flex items-center gap-2\" data-kid=\"1-5-1-1-1-4-3\" data-name=\"experience label\">\n                            <iconify-icon data-kid=\"1-5-1-1-1-4-3-1\" data-name=\"experience icon\" icon=\"mdi:briefcase-outline\" style=\"color:var(--violet);width:18px;height:18px\">\n                            </iconify-icon>\n                            +3 años de experiencia\n                        </span>\n                    </div>\n                    <div class=\"flex flex-wrap gap-2 pt-2 md:gap-3\" data-kid=\"1-5-1-1-1-5\" data-name=\"social links button group\">\n                        <a class=\"inline-flex items-center gap-2 rounded-lg border border-[var(--dark-border)]/60 bg-white/5 px-4 py-2.5 text-sm text-gray-300 transition hover:border-[var(--blue)]/50 hover:bg-white/10 hover:text-white\" data-kid=\"1-5-1-1-1-5-1\" data-name=\"github link button\" href=\"https://github.com/angelcruz07\">\n                            <iconify-icon data-kid=\"1-5-1-1-1-5-1-1\" data-name=\"github icon\" icon=\"mdi:github\" style=\"color:currentColor;width:17px;height:17px\">\n                            </iconify-icon>\n                            GitHub\n                        </a>\n                        <a class=\"inline-flex items-center gap-2 rounded-lg border border-[var(--dark-border)]/60 bg-white/5 px-4 py-2.5 text-sm text-gray-300 transition hover:border-[var(--blue)]/50 hover:bg-white/10 hover:text-white\" data-kid=\"1-5-1-1-1-5-2\" data-name=\"linkedin link button\" href=\"https://www.linkedin.com/in/angelcruzsanchez\">\n                            <iconify-icon data-kid=\"1-5-1-1-1-5-2-1\" data-name=\"linkedin icon\" icon=\"mdi:linkedin\" style=\"color:currentColor;width:17px;height:17px\">\n                            </iconify-icon>\n                            LinkedIn\n                        </a>\n                        <a class=\"inline-flex items-center gap-2 rounded-lg border border-[var(--dark-border)]/60 bg-white/5 px-4 py-2.5 text-sm text-gray-300 transition hover:border-[var(--blue)]/50 hover:bg-white/10 hover:text-white\" data-kid=\"1-5-1-1-1-5-3\" data-name=\"contact link button\" href=\"mailto:angelcruzsanchez126@gmail.com\">\n                            <iconify-icon data-kid=\"1-5-1-1-1-5-3-1\" data-name=\"email icon\" icon=\"mdi:email-outline\" style=\"color:currentColor;width:17px;height:17px\">\n                            </iconify-icon>\n                            Contactar\n                        </a>\n                        <a class=\"inline-flex items-center gap-2 rounded-lg border border-[var(--dark-border)]/60 bg-white/5 px-4 py-2.5 text-sm text-gray-300 transition hover:border-[var(--blue)]/50 hover:bg-white/10 hover:text-white\" data-kid=\"1-5-1-1-1-5-4\" data-name=\"download cv button\" href=\"https://drive.google.com/file/d/1pRfPQxEf3CNWgmEw991yAmlNwYsbyJmr/view?usp=sharing\">\n                            <iconify-icon data-kid=\"1-5-1-1-1-5-4-1\" data-name=\"download icon\" icon=\"mdi:download-outline\" style=\"color:currentColor;width:17px;height:17px\">\n                            </iconify-icon>\n                            Descargar CV\n                        </a>\n                    </div>\n                </div>\n                <div class=\"preview-fade-in shrink-0\" data-kid=\"1-5-1-1-2\" data-name=\"hero profile image container\" style=\"animation-delay:.35s\">\n                    <div class=\"relative group\" data-kid=\"1-5-1-1-2-1\" data-name=\"hero profile image wrapper\">\n                        <div class=\"absolute -inset-4 rounded-full bg-gradient-to-r from-[var(--blue)]/20 via-[var(--violet)]/20 to-[var(--green)]/20 blur-2xl\" data-kid=\"1-5-1-1-2-1-1\" data-name=\"profile glow background\">\n                        </div>\n                        <div class=\"relative\" data-kid=\"1-5-1-1-2-1-2\" data-name=\"profile photo container\">\n                            <img alt=\"Lizandro Antonio Santos\" class=\"relative h-[200px] w-[200px] rounded-full border-2 border-[var(--dark-border)]/60 object-cover shadow-2xl shadow-black/50 md:h-[240px] md:w-[240px]\" data-kid=\"1-5-1-1-2-1-2-1\" data-name=\"profile image\" decoding=\"async\" height=\"200\" loading=\"lazy\" src=\"/api/local/images/public/yo.jpg\" width=\"200\"/>\n                            <span class=\"absolute bottom-1 right-7 h-6 w-6 rounded-full border-4 border-[var(--dark-bg)] bg-[var(--green)] shadow-lg\" data-kid=\"1-5-1-1-2-1-2-2\" data-name=\"status indicator badge\">\n                                <span class=\"block h-full w-full animate-ping rounded-full bg-[var(--green)] opacity-75\" data-kid=\"1-5-1-1-2-1-2-2-1\" data-name=\"status ping animation\">\n                                </span>\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"preview-fade-in relative mt-8 overflow-hidden rounded-3xl border border-[var(--dark-border)]/60 bg-gradient-to-br from-[var(--dark-surface)]/70 via-[var(--dark-surface)]/40 to-[var(--dark-surface)]/70 p-8 text-center backdrop-blur-xl md:mt-12 md:p-10\" data-kid=\"1-5-1-2\" data-name=\"hero quote section\" style=\"animation-delay:.45s\">\n                <div class=\"absolute inset-0 bg-gradient-to-r from-[var(--blue)]/5 via-transparent to-[var(--violet)]/5\" data-kid=\"1-5-1-2-1\" data-name=\"quote background gradient\">\n                </div>\n                <div class=\"relative z-10\" data-kid=\"1-5-1-2-2\" data-name=\"quote text wrapper\">\n                    <iconify-icon data-kid=\"1-5-1-2-2-1\" data-name=\"quote icon\" icon=\"mdi:format-quote-open\" style=\"color:color-mix(in srgb, var(--blue) 32%, transparent);width:40px;height:40px;margin:0 auto 16px\">\n                    </iconify-icon>\n                    <p class=\"mx-auto mb-3 max-w-3xl text-xl font-medium italic leading-[1.7] text-gray-200 md:text-2xl\" data-kid=\"1-5-1-2-2-2\" data-name=\"quote content\">\n                        \"A clean programmer is the best kind of programmer\"\n                    </p>\n                    <p class=\"text-sm text-gray-500\" data-kid=\"1-5-1-2-2-3\" data-name=\"quote author name\">\n                        — Alan Buscaglia\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"trayectoria-title\" class=\"mt-32 mb-24 md:mt-40\" data-kid=\"1-5-2\" data-name=\"experience section\" id=\"trayectoria\">\n            <div class=\"flex flex-col items-start gap-4 md:flex-row md:items-center md:gap-6\" data-kid=\"1-5-2-1\" data-name=\"experience section header\">\n                <h2 class=\"flex shrink-0 items-center gap-3 text-3xl font-bold text-[var(--violet)] md:text-4xl lg:text-5xl\" data-kid=\"1-5-2-1-1\" data-name=\"experience title\" id=\"trayectoria-title\">\n                    <iconify-icon data-kid=\"1-5-2-1-1-1\" data-name=\"experience icon\" icon=\"mdi:briefcase-outline\" style=\"color:var(--violet);width:28px;height:28px\">\n                    </iconify-icon>\n                    Trayectoria\n                </h2>\n                <div class=\"section-rule mt-2 h-px w-full flex-1 md:ml-6 md:mt-0\" data-kid=\"1-5-2-1-2\" data-name=\"section rule line\">\n                </div>\n            </div>\n            <div class=\"mt-12 grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-8 lg:gap-12\" data-kid=\"1-5-2-2\" data-name=\"timeline grid\">\n                <div class=\"preview-slide-in\" data-kid=\"1-5-2-2-1\" data-name=\"career column\" style=\"animation-delay:.15s\">\n                    <div class=\"mb-7 flex items-center gap-3\" data-kid=\"1-5-2-2-1-1\" data-name=\"career header\">\n                        <span class=\"flex h-9 w-9 items-center justify-center rounded-xl border border-[var(--violet)]/20 bg-[var(--violet)]/10\" data-kid=\"1-5-2-2-1-1-1\" data-name=\"career icon\">\n                            <iconify-icon data-kid=\"1-5-2-2-1-1-1-1\" icon=\"mdi:briefcase-variant-outline\" style=\"color:var(--violet);width:19px;height:19px\">\n                            </iconify-icon>\n                        </span>\n                        <div data-kid=\"1-5-2-2-1-1-2\" data-name=\"career text\">\n                            <p class=\"text-xs font-medium uppercase tracking-[.2em] text-[var(--violet)]/80\" data-kid=\"1-5-2-2-1-1-2-1\" data-name=\"career eyebrow\">\n                                Trayectoria\n                            </p>\n                            <h3 class=\"text-2xl font-bold text-white\" data-kid=\"1-5-2-2-1-1-2-2\" data-name=\"career main title\">\n                                Experiencia profesional\n                            </h3>\n                        </div>\n                    </div>\n                    <ol class=\"timeline-line relative ml-3 border-l-2 border-[var(--dark-border)]/70\" data-kid=\"1-5-2-2-1-2\" data-name=\"timeline list\">\n                        <li class=\"group relative ml-8 pb-7\" data-kid=\"1-5-2-2-1-2-1\" data-name=\"career item 1\">\n                            <span class=\"absolute -left-[41px] top-2 flex h-4 w-4 items-center justify-center rounded-full bg-gradient-to-br from-[var(--blue)] to-[var(--violet)] ring-4 ring-[var(--dark-bg)]\" data-kid=\"1-5-2-2-1-2-1-1\" data-name=\"timeline marker 1\">\n                                <span class=\"h-2 w-2 rounded-full bg-white\" data-kid=\"1-5-2-2-1-2-1-1-1\" data-name=\"marker center 1\">\n                                </span>\n                            </span>\n                            <article class=\"glass-card relative overflow-hidden rounded-xl p-5 transition duration-500\" data-kid=\"1-5-2-2-1-2-1-2\" data-name=\"career item card 1\">\n                                <div class=\"absolute inset-0 bg-gradient-to-r from-[var(--blue)]/5 via-transparent to-[var(--violet)]/5 opacity-0 transition group-hover:opacity-100\" data-kid=\"1-5-2-2-1-2-1-2-1\" data-name=\"card hover gradient\">\n                                </div>\n                                <div class=\"relative\" data-kid=\"1-5-2-2-1-2-1-2-2\" data-name=\"card body 1\">\n                       