---
const { href } = Astro.props
---

<a
  href={href}
  class="flex justify-center items-center
    gap-x-2 py-2 px-4
    text-gray-300 hover:text-white
    rounded-full
    hover:bg-white/5
    transition-all duration-300 ease-out
    cursor-pointer
    relative
    group">
  <span class="relative z-10"><slot /></span>
  <span class="absolute inset-0 rounded-full bg-gradient-to-r from-blue/20 to-violet/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
</a>
