---
const { color } = Astro.props
---

<h2 class={`${color} text-3xl md:text-4xl lg:text-5xl font-bold md:mb-8 mt-8 first:mt-0 flex flex-col md:flex-row gap-4 md:gap-6 items-start md:items-center group`}>
  <span class="flex items-center gap-3 flex-shrink-0">
    <slot />
  </span>
  <div class="flex-1 w-full md:w-auto h-px bg-gradient-to-r from-dark-border via-dark-border/50 to-transparent mt-2 md:mt-0 md:ml-6"></div>
</h2>