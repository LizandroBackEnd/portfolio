---
import ExperienceItem from '../ui/ExperienceItem.astro'
import Brifcase from '../../icons/Brifcase.astro'
import Profile from '../../icons/Profile.astro'
import Title from '../ui/Title .astro'

const WORK_EXPERIENCE = [
  {
    id: 1,
    date: 'Actualidad',
    title: 'Backend & Cloud Engineer - The Cloud Mastery',
    description:
      'Desarrollo de infraestructura y servicios utilizando Next.js, TypeScript, Docker, PostgreSQL y servicios en la nube de Azure. Implementación de infraestructura con ARM Templates y creación de una solución para obtener, analizar y predecir los costos de un tenant de Azure.',
    link: 'https://www.thecloudmastery.com/'
  },
  {
    id: 2,
    date: 'Actualidad',
    title: 'Founder & Lead Tech - Codeverse',
    description:
      'Co-fundé Codeverse junto a Angel Alejandro, una consultora de desarrollo de software enfocada en construir soluciones digitales y acompañar a organizaciones en sus procesos tecnológicos.',
    link: 'https://www.codeverse.com.mx/'
  },
  {
    id: 3,
    date: 'Experiencia previa',
    title: 'Software Developer - Xalachi',
    description:
      'Diseño y desarrollo de una API REST para facturación electrónica utilizando NestJS y Clean Architecture, logrando reducir en un 50% el tiempo de integración en nuevos productos. Integración segura entre un sistema moderno en NestJS y otro en PHP nativo mediante una red interna de Docker. Desarrollo de un middleware de timbrado de notas de crédito para asegurar la estabilidad y el flujo transaccional.',
    link: 'https://xalachi.com/'
  },
]

const STUDIES = [
  {
    id: 1,
    date: 'Actualmente',
    title: 'Ingeniería de Software Multiplataforma',
    description:
      'Durante la carrera he aprendido y aplicado metodologías ágiles como Scrum y Design Thinking, además de trabajar con Kotlin para desarrollo móvil, fundamentos de redes y programación aplicada a la inteligencia artificial. También he participado en proyectos reales, fortaleciendo mi capacidad para diseñar y construir soluciones de software.',
    link: null
  },
  {
    id: 2,
    date: 'Formación técnica',
    title: 'Técnico en Programación',
    description:
      'Participé en proyectos internos para la escuela y desarrollé junto con un compañero la web Sultepec Turístico. Aprendí fundamentos de programación y POO, además de React Native para aplicaciones móviles y PHP, MySQL, HTML, CSS, Next.js y Tailwind para desarrollo web.',
    link: 'https://sultepecturistico.vercel.app/',
    linkLabel: 'Ver proyecto'
  }
]

---

<div class="space-y-24">
  <section>
    <Title color="text-violet" class="text-2xl md:text-3xl lg:text-4xl">
      <Brifcase class="size-6 md:size-7" />
      Experiencia profesional
    </Title>
    <div class="timeline mt-12" data-timeline>
      <span class="timeline-track" aria-hidden="true"></span>
      <span class="timeline-progress" aria-hidden="true"></span>
      <ol class="relative ml-4 space-y-2">
        {
          WORK_EXPERIENCE.map((experience) => (
            <li class="timeline-item" data-timeline-item>
              <ExperienceItem {...experience} />
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section>
    <Title color="text-green" class="text-2xl md:text-3xl lg:text-4xl">
      <Profile class="size-6 md:size-7" />
      Estudios
    </Title>
    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          STUDIES.map((study) => (
            <div class="timeline-item is-visible">
              <ExperienceItem {...study} showDot={false} />
            </div>
          ))
        }
    </div>
  </section>
</div>

<script>
  const timelines = document.querySelectorAll('[data-timeline]')

  timelines.forEach((timeline) => {
    const items = timeline.querySelectorAll('[data-timeline-item]')
    const progress = timeline.querySelector('.timeline-progress')

    const updateProgress = () => {
      const timelineTop = timeline.getBoundingClientRect().top + window.scrollY
      const viewportLine = window.scrollY + window.innerHeight * 0.7
      let progressHeight = 0

      items.forEach((item) => {
        const itemTop = item.getBoundingClientRect().top + window.scrollY
        if (itemTop <= viewportLine) {
          progressHeight = Math.max(progressHeight, itemTop - timelineTop + 10)
        }
      })

      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 24) {
        progressHeight = timeline.offsetHeight - 12
      }

      progress.style.height = `${progressHeight}px`
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add('is-visible')
        })
        updateProgress()
      },
      { threshold: 0.18, rootMargin: '0px 0px -8% 0px' }
    )

    items.forEach((item) => observer.observe(item))
    window.addEventListener('scroll', updateProgress, { passive: true })
    window.addEventListener('resize', updateProgress)
    updateProgress()
  })
</script>

<style>
  .timeline {
    position: relative;
  }

  .timeline-track,
  .timeline-progress {
    position: absolute;
    top: 0.75rem;
    bottom: 0.75rem;
    left: 1rem;
    width: 2px;
    border-radius: 999px;
  }

  .timeline-track {
    background: rgba(42, 42, 58, 0.65);
  }

  .timeline-progress {
    bottom: auto;
    height: 0;
    background: linear-gradient(180deg, #2ccbf3, #bb99fa, #b6d161);
    box-shadow: 0 0 14px rgba(44, 203, 243, 0.65);
    transition: height 0.45s ease-out;
  }

  .timeline-item {
    position: relative;
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.65s ease-out, transform 0.65s ease-out;
  }

  .timeline-item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-item {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .timeline-progress {
      transition: none;
    }
  }
</style>
